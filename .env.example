# Environment: development | production | test
NODE_ENV=
PORT=
MONGODB_URI=

# Email Provider: smtp (default) | resend
EMAIL_PROVIDER=

# Resend API Configuration (Required when EMAIL_PROVIDER=resend, e.g. on Render Free tier)
RESEND_API_KEY=
RESEND_FROM=

# SMTP Configuration (Required when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# Automatically attach a generated PDF delivery document to all emails (true/false)
AUTO_ATTACH_PDF=

# Redis & BullMQ Queue Configuration (Required in production, optional in development)
REDIS_URL=
QUEUE_CONCURRENCY=

# Health checks  Per-dependency round-trip budget for the GET /health dependency probe
HEALTH_PROBE_TIMEOUT_MS=

# Logging (Winston) # LOG_LEVEL: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=
LOG_DIR=
