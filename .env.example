# Environment: development | production | test
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/email-sender

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Email Sender <your@gmail.com>"

SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# Automatically attach a generated PDF delivery document to all emails (true/false)
AUTO_ATTACH_PDF=true

# Redis & BullMQ Queue Configuration (Required in production, optional in development)
REDIS_URL=redis://127.0.0.1:6379
QUEUE_CONCURRENCY=5

# Logging (Winston)
# LOG_LEVEL: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
LOG_DIR=logs
